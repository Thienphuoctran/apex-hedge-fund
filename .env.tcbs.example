# ==============================================================================
# TCBS / TCINVEST SECURE READ-ONLY CREDENTIALS CONFIGURATION
# CƠ QUAN BẢO MẬT: PALMER (CENTRAL ARCHITECTURE) & MASTER CIO JAMES (BAN 8)
# LƯU Ý BẢO MẬT: File này được bảo vệ bởi .gitignore, KHÔNG BAO GIỜ PUSH LÊN GIT!
# CHẾ ĐỘ: 100% READ-ONLY (CHỈ XEM BẢNG GIÁ, SỐ DƯ & DANH MỤC - CẤM ĐẶT LỆNH/RÚT TIỀN)
# ==============================================================================

# Số tài khoản chứng khoán TCBS của Chủ tịch (Mặc định: 105C307855)
TCBS_ACCOUNT=105C307855

# Tiểu khoản chứng khoán thường (Mặc định: 105C307855)
TCBS_SUB_ACCOUNT=105C307855

# ==============================================================================
# PHƯƠNG ÁN 1: DÙNG SESSION TOKEN WEB (KHUYẾN NGHỊ CAO NHẤT - AN TOÀN NHẤT)
# Chủ tịch đăng nhập tcinvest.tcbs.com.vn trên trình duyệt -> F12 -> Console hoặc Application
# Copy chuỗi JWT Bearer Token dán vào đây (KHÔNG CẦN CUNG CẤP PASSWORD!)
# ==============================================================================
TCINVEST_SESSION_TOKEN=

# ==============================================================================
# PHƯƠNG ÁN 2: DÙNG TCBS OPENAPI KEY (NẾU ĐĂNG KÝ TRÊN openapi.tcbs.com.vn)
# ==============================================================================
TCBS_OPENAPI_KEY=
TCBS_OPENAPI_SECRET=

# ==============================================================================
# PHƯƠNG ÁN 3: TỰ ĐỘNG ĐĂNG NHẬP HEADLESS (NẾU MUỐN AI TỰ LÀM MỌI THỨ)
# (Lưu ý: Chỉ lưu trong file cục bộ .env.tcbs, tuyệt đối không push lên Git)
# ==============================================================================
TCBS_USERNAME=
TCBS_PASSWORD=

# KHÓA CỨNG BẢO MẬT BẮT BUỘC (LUÔN PHẢI LÀ TRUE ĐỂ CHẶN 100% RÚT TIỀN/ĐẶT LỆNH)
ENFORCE_READ_ONLY=True
